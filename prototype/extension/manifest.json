{
  "manifest_version": 3,
  "name": "Tesi E-commerce Demo",
  "version": "0.2.0",
  "description": "Estensione Chrome per collegare il prototipo locale e riconoscere prodotti Amazon reali.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:3000/*",
    "https://*.amazon.com/*",
    "https://*.amazon.it/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.es/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tesi E-commerce Demo"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/product.html*",
        "https://*.amazon.com/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*"
      ],
      "js": [
        "product_detector.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
